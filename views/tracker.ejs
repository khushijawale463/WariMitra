     PHASE 2 FEATURE 6: CROWD DENSITY HEATMAP LAYER
  ------------------------------------------------------------- */
  function toggleCrowdHeatmap() {
    const btn = document.getElementById('btn-toggle-heatmap');

    if (!isHeatmapActive) {
      fetch('/tracker/api/crowd-density')
        .then(res => res.json())
        .then(data => {
          if (data.success && data.heatmapData) {
            if (heatmapLayer && mapInstance) mapInstance.removeLayer(heatmapLayer);
            if (typeof L.heatLayer === 'function') {
              heatmapLayer = L.heatLayer(data.heatmapData, {
                radius: 25,
                blur: 15,
                maxZoom: 16,
                gradient: { 0.4: 'blue', 0.65: 'lime', 0.9: 'red' }
              }).addTo(mapInstance);
              isHeatmapActive = true;
              btn.classList.add('active');
              btn.style.background = '#F59E0B';
              btn.style.color = '#FFFFFF';
              speakMarathiPrompt("गर्दीची घनता दाखवणारा नकाशा दाखवला आहे"); // Heatmap layer activated
            } else {
              alert('Heatmap plugin loading... please try again in a moment.');
            }
          }
        });
    } else {
      if (heatmapLayer && mapInstance) mapInstance.removeLayer(heatmapLayer);
      isHeatmapActive = false;
      btn.classList.remove('active');
      btn.style.background = '';
      btn.style.color = '';
    }
  }

