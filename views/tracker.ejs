  function checkUrlNavigationParams() {
    const params = new URLSearchParams(window.location.search);
    const navToLat = parseFloat(params.get('navToLat'));
    const navToLng = parseFloat(params.get('navToLng'));
    const title = params.get('title');

    if (!isNaN(navToLat) && !isNaN(navToLng)) {
      const navTitle = title ? decodeURIComponent(title) : 'Target Destination';
      setTimeout(() => {
        startNavigation(navToLat, navToLng, navTitle);
      }, 500);
    }
  }

  function fetchNearbyFacilities() {
    const radius = document.getElementById('facility-radius-select').value || 2000;
    const cat = activeFacilitySubCat;

    fetch(`/facilities/api/nearby?lat=${userLoc.lat}&lng=${userLoc.lng}&radius=${radius}&category=${cat}`)
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          renderFacilityMarkers(data.facilities);
        }
      })
      .catch(err => console.warn('Facilities fetch error:', err));
  }

  function renderFacilityMarkers(facilities) {
    facilityMarkers.forEach(m => mapInstance.removeLayer(m));
    facilityMarkers = [];

    const categoryIcons = {
      Medical: { icon: 'fa-hospital', color: '#DC2626' },
      Water: { icon: 'fa-droplet', color: '#0284C7' },
      Food: { icon: 'fa-utensils', color: '#D97706' },
      Shelter: { icon: 'fa-campground', color: '#16A34A' },
      Toilet: { icon: 'fa-restroom', color: '#8B5CF6' },
      Parking: { icon: 'fa-square-parking', color: '#475569' },
      Other: { icon: 'fa-info', color: '#E65100' }
    };

    facilities.forEach(fac => {
      const cfg = categoryIcons[fac.category] || categoryIcons.Other;
      const fIcon = L.divIcon({
        className: 'custom-leaflet-marker',
        html: `<div style="background:${cfg.color}; color:#fff; width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; border:2px solid #fff; box-shadow:0 4px 10px rgba(0,0,0,0.3); font-size:13px;"><i class="fa-solid ${cfg.icon}"></i></div>`,
        iconSize: [30, 30],
        iconAnchor: [15, 15]
      });

      const m = L.marker([fac.lat, fac.lng], { icon: fIcon });
      if (currentFilter === 'all' || currentFilter === 'facilities') {
        m.addTo(mapInstance);
      }

      const statusBadge = fac.status === 'Open' 
        ? `<span class="badge-status-open">Open</span>`
        : `<span class="badge-status-busy">Busy</span>`;

      m.bindPopup(`
        <div class="custom-infowindow">
          <div class="infowindow-title" style="display:flex; justify-content:space-between; align-items:center;">
            <span><i class="fa-solid ${cfg.icon}" style="color:${cfg.color};"></i> ${fac.name}</span>
            ${statusBadge}
          </div>
          <div class="infowindow-desc">
            <strong>${fac.category} Camp</strong> • ${formatDistanceText(fac.distanceMeters)} away<br>
            <i class="fa-solid fa-location-dot"></i> ${fac.location}<br>
            ${fac.contact ? `<i class="fa-solid fa-phone"></i> ${fac.contact}` : ''}
          </div>
          <button class="btn-infowindow" onclick="startNavigation(${fac.lat}, ${fac.lng}, '${fac.name.replace(/'/g, "\\'")}')">
            <i class="fa-solid fa-diamond-turn-right"></i> Navigate Here
