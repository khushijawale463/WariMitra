  function startNavigation(targetLat, targetLng, targetTitle) {
    activeTarget = { lat: targetLat, lng: targetLng, title: targetTitle };
    isNavigating = true;

    document.getElementById('nav-drawer').style.display = 'flex';
    document.getElementById('nav-target-name').textContent = targetTitle;
    document.getElementById('nav-dist-text').textContent = 'Calculating...';
    document.getElementById('nav-eta-text').textContent = '...';

    // Voice announcement in Marathi
    speakMarathiPrompt(`मार्ग सुरु करत आहे: ${targetTitle}`);

    fetchRouteAndDraw(userLoc.lat, userLoc.lng, targetLat, targetLng);

    if (!watchPositionId && navigator.geolocation) {
      watchPositionId = navigator.geolocation.watchPosition(
        onPositionUpdate,
        err => console.warn('Position watch error:', err.message),
        { enableHighAccuracy: true, timeout: 15000, maximumAge: 10000 }
      );
    }
  }

  function fetchRouteAndDraw(startLat, startLng, endLat, endLng) {
    lastCalcLoc = { lat: startLat, lng: startLng };

    fetch(`/api/navigation/route?startLat=${startLat}&startLng=${startLng}&endLat=${endLat}&endLng=${endLng}`)
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          renderRoutePolyline(data.geometry);
          updateNavDrawerMetrics(data.distanceMeters, data.durationSeconds, data.legs);
        }
      })
      .catch(err => {
        console.warn('Navigation route fetch fallback:', err);
        renderRoutePolyline({
          type: 'LineString',
          coordinates: [[startLng, startLat], [endLng, endLat]]
        });
        const dist = haversineMeters(startLat, startLng, endLat, endLng);
        updateNavDrawerMetrics(dist, Math.round(dist / 1.11), []);
      });
  }

  function renderRoutePolyline(geometry) {
    if (activePolyline && mapInstance) {
      mapInstance.removeLayer(activePolyline);
    }

    if (!geometry || !geometry.coordinates) return;

    const latLngs = geometry.coordinates.map(c => [c[1], c[0]]);

    activePolyline = L.polyline(latLngs, {
      color: '#E65100',
      weight: 6,
      opacity: 0.9,
      lineCap: 'round',
      lineJoin: 'round'
    }).addTo(mapInstance);

    mapInstance.fitBounds(activePolyline.getBounds(), { padding: [40, 40] });
  }

  function updateNavDrawerMetrics(distanceMeters, durationSeconds, legs) {
    document.getElementById('nav-dist-text').textContent = formatDistanceText(distanceMeters);

    const minutes = Math.max(1, Math.round(durationSeconds / 60));
    if (minutes > 60) {
      const hrs = (minutes / 60).toFixed(1);
      document.getElementById('nav-eta-text').textContent = `${hrs} hrs`;
    } else {
      document.getElementById('nav-eta-text').textContent = `${minutes} mins`;
    }

    const stepsListEl = document.getElementById('nav-steps-list');
    stepsListEl.innerHTML = '';

    let allSteps = [];
    if (legs && legs.length > 0 && legs[0].steps && legs[0].steps.length > 0) {
      allSteps = legs[0].steps;
    }

    document.getElementById('nav-step-count').textContent = allSteps.length || 1;

    if (allSteps.length === 0) {
      stepsListEl.innerHTML = `
        <div class="nav-step-item active-step">
          <div class="nav-step-icon"><i class="fa-solid fa-person-walking"></i></div>
          <div class="nav-step-info">
            <div class="nav-step-text">Walk directly towards ${activeTarget ? activeTarget.title : 'destination'}</div>
            <div class="nav-step-dist">${formatDistanceText(distanceMeters)} remaining</div>
          </div>
        </div>
      `;
      return;
    }

    const maneuverIconMap = {
      'turn-left': 'fa-arrow-left',
      'turn-right': 'fa-arrow-right',
      'sharp-left': 'fa-arrow-turn-down',
      'sharp-right': 'fa-arrow-turn-down',
      'slight-left': 'fa-arrow-up-left',
      'slight-right': 'fa-arrow-up-right',
      'straight': 'fa-arrow-up',
      'arrive': 'fa-location-dot',
      'depart': 'fa-person-walking'
    };

    allSteps.forEach((st, idx) => {
      const mType = (st.maneuver ? st.maneuver.type + '-' + (st.maneuver.modifier || '') : 'straight').toLowerCase();
      let iconClass = 'fa-arrow-up';
      for (let k in maneuverIconMap) {
        if (mType.includes(k)) iconClass = maneuverIconMap[k];
      }
      if (st.maneuver && st.maneuver.type === 'arrive') iconClass = 'fa-location-dot';

      const instruction = (st.maneuver && st.maneuver.instruction) || st.name || `Continue along path (${formatDistanceText(Math.round(st.distance))})`;
      const isActive = idx === 0 ? 'active-step' : '';

      stepsListEl.innerHTML += `
        <div class="nav-step-item ${isActive}">
          <div class="nav-step-icon"><i class="fa-solid ${iconClass}"></i></div>
          <div class="nav-step-info">
            <div class="nav-step-text">${instruction}</div>
            <div class="nav-step-dist">${formatDistanceText(Math.round(st.distance))}</div>
          </div>
        </div>
      `;
    });

    // Voice prompt for upcoming turn in Marathi
    if (allSteps.length > 0 && allSteps[0].maneuver) {
      const mod = allSteps[0].maneuver.modifier || '';
      if (mod.includes('left')) speakMarathiPrompt("पुढे डावीकडे वळा");
      else if (mod.includes('right')) speakMarathiPrompt("पुढे उजवीकडे वळा");
      else speakMarathiPrompt("सरळ रस्ता धरा");
    }
  }

  function toggleNavStepsDrawer() {
    const list = document.getElementById('nav-steps-list');
    const icon = document.getElementById('nav-drawer-toggle-icon');
    if (list.style.display === 'none') {
      list.style.display = 'flex';
      icon.innerHTML = '<i class="fa-solid fa-chevron-up"></i>';
    } else {
      list.style.display = 'none';
      icon.innerHTML = '<i class="fa-solid fa-chevron-down"></i>';
    }
  }

  function stopNavigation() {
    isNavigating = false;
    activeTarget = null;
    if (activePolyline && mapInstance) {
      mapInstance.removeLayer(activePolyline);
      activePolyline = null;
    }
    document.getElementById('nav-drawer').style.display = 'none';
  }

  function onPositionUpdate(pos) {
    const newLat = pos.coords.latitude;
    const newLng = pos.coords.longitude;

    userLoc.lat = newLat;
    userLoc.lng = newLng;

    if (markersMap['user']) {
      markersMap['user'].setLatLng([newLat, newLng]);
    }

    // Buffer GPS ping if offline
    if (!navigator.onLine) {
      bufferGpsPingOffline(newLat, newLng);
    }

    // Check Stray separation status
    checkStrayStatus();

    // Dynamic UI distance updates
    updateAllLiveDistances();

    // Recalculate route polyline & ETA if moved > 15 meters during navigation
    if (isNavigating && activeTarget) {
      if (!lastCalcLoc || haversineMeters(lastCalcLoc.lat, lastCalcLoc.lng, newLat, newLng) > 15) {
        fetchRouteAndDraw(newLat, newLng, activeTarget.lat, activeTarget.lng);
      }
    }
  }

  function updateAllLiveDistances() {
    friendsData.forEach(f => {
      const d = haversineMeters(userLoc.lat, userLoc.lng, f.lat, f.lng);
      const text = formatDistanceText(d) + ' away';
      if (document.getElementById(`dist-${f.id}`)) {
        document.getElementById(`dist-${f.id}`).textContent = text;
      }
      if (document.getElementById(`dist-tab-${f.id}`)) {
        document.getElementById(`dist-tab-${f.id}`).textContent = text;
      }
    });
  }

  function centerOnUser() {
    if (mapInstance) {
      mapInstance.setView([userLoc.lat, userLoc.lng], 15);
      if (markersMap['user']) markersMap['user'].openPopup();
    }
  }

  function focusMarker(id) {
    const m = markersMap[id];
    if (m && mapInstance) {
      mapInstance.setView(m.getLatLng(), 16);
      m.openPopup();
    }
  }

  function filterMapCategory(cat) {
    currentFilter = cat;
    ['btn-filter-all', 'btn-filter-dindi', 'btn-filter-friends', 'btn-filter-facilities'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.remove('active');
    });
    document.getElementById(`btn-filter-${cat}`).classList.add('active');

    troopsData.forEach(t => {
      const m = markersMap[t.id];
      if (m) {
        if (cat === 'all' || cat === 'dindi') m.addTo(mapInstance);
        else mapInstance.removeLayer(m);
      }
    });

    friendsData.forEach(f => {
      const m = markersMap[f.id];
      if (m) {
        if (cat === 'all' || cat === 'friends') m.addTo(mapInstance);
        else mapInstance.removeLayer(m);
      }
    });

    facilityMarkers.forEach(m => {
      if (cat === 'all' || cat === 'facilities') m.addTo(mapInstance);
      else mapInstance.removeLayer(m);
    });
  }

  function switchTrackerTab(tab) {
    const btnTroop = document.getElementById('btn-tab-troop');
    const btnFriends = document.getElementById('btn-tab-friends');
    const contentTroop = document.getElementById('tab-troop-content');
    const contentFriends = document.getElementById('tab-friends-content');

    if (tab === 'troop') {
      btnTroop.classList.add('active');
      btnFriends.classList.remove('active');
      contentTroop.style.display = 'block';
      contentFriends.style.display = 'none';
    } else {
      btnFriends.classList.add('active');
      btnTroop.classList.remove('active');
      contentFriends.style.display = 'block';
      contentTroop.style.display = 'none';
    }
  }

  function toggleLiveLocation(enabled) {
    const badge = document.getElementById('location-pulse-badge');
    const text = document.getElementById('location-status-text');

    if (enabled) {
      badge.className = 'pulse-badge active';
      text.textContent = 'Live Location Active';
      text.style.color = '#22C55E';

      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(onPositionUpdate, err => {
          console.warn('Geolocation warning:', err.message);
        });
      }
    } else {
      badge.className = 'pulse-badge inactive';
      text.textContent = 'Location Sharing Off';
      text.style.color = '#94A3B8';
    }
  }

  function filterTrackerList(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('.member-item-card').forEach(card => {
      const name = card.getAttribute('data-name') || '';
      if (name.toLowerCase().includes(q)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function shareTrackerLink() {
    if (navigator.share) {
      navigator.share({
        title: 'Join My Warkari Dindi on WariMitra',
        text: 'Track my live location and join our Dindi group on the Pandharpur Wari portal!',
        url: window.location.href
      }).catch(() => {});
    } else {
      navigator.clipboard.writeText(window.location.href);
      alert('Tracker link copied to clipboard! Share it with your friends.');
    }
  }

  // Load Map on DOM Ready
  document.addEventListener('DOMContentLoaded', initTrackerMap);
</script>

