  /* -------------------------------------------------------------
     PHASE 2 FEATURE 5: OFFLINE MAP CACHING & LOCATION BUFFERING
  ------------------------------------------------------------- */
  function setupOfflineNetworkListeners() {
    const syncBadge = document.getElementById('network-sync-badge');

    function updateNetworkStatus() {
      if (navigator.onLine) {
        if (syncBadge) {
          syncBadge.className = 'sync-status-badge online';
          syncBadge.innerHTML = '<i class="fa-solid fa-wifi"></i> Online';
        }
        syncBufferedPings();
      } else {
        if (syncBadge) {
          syncBadge.className = 'sync-status-badge offline';
          syncBadge.innerHTML = '<i class="fa-solid fa-plane-slash"></i> Offline (Buffering)';
        }
      }
    }

    window.addEventListener('online', updateNetworkStatus);
    window.addEventListener('offline', updateNetworkStatus);
    updateNetworkStatus();
  }

  /* Fullscreen Screen Mode Toggle Function */
  function toggleMapFullscreen() {
    const wrapper = document.querySelector('.map-container-wrapper');
    const btn = document.getElementById('btn-toggle-fullscreen');
    if (!wrapper) return;

    const isFs = wrapper.classList.contains('map-fullscreen-active');

    if (!isFs) {
      wrapper.classList.add('map-fullscreen-active');
      if (btn) {
        btn.classList.add('btn-fullscreen-active');
        btn.innerHTML = '<i class="fa-solid fa-compress"></i> Exit Fullscreen';
      }

      if (wrapper.requestFullscreen) {
        wrapper.requestFullscreen().catch(() => {});
      } else if (wrapper.webkitRequestFullscreen) {
        wrapper.webkitRequestFullscreen();
      }
    } else {
      wrapper.classList.remove('map-fullscreen-active');
      if (btn) {
        btn.classList.remove('btn-fullscreen-active');
        btn.innerHTML = '<i class="fa-solid fa-expand"></i> Fullscreen';
      }

      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }
    }

    // Trigger Leaflet map resize event
    setTimeout(() => {
      if (mapInstance && mapInstance.invalidateSize) {
        mapInstance.invalidateSize();
      }
    }, 300);
  }

  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement) {
      const wrapper = document.querySelector('.map-container-wrapper');
      const btn = document.getElementById('btn-toggle-fullscreen');
      if (wrapper && wrapper.classList.contains('map-fullscreen-active')) {
        wrapper.classList.remove('map-fullscreen-active');
      }
      if (btn && btn.classList.contains('btn-fullscreen-active')) {
        btn.classList.remove('btn-fullscreen-active');
        btn.innerHTML = '<i class="fa-solid fa-expand"></i> Fullscreen';
      }
      setTimeout(() => {
        if (mapInstance && mapInstance.invalidateSize) mapInstance.invalidateSize();
      }, 300);
    }
  });

  function bufferGpsPingOffline(lat, lng) {

    const ping = { lat, lng, timestamp: new Date().toISOString() };
    try {
      let saved = JSON.parse(localStorage.getItem('wari_offline_gps_queue') || '[]');
      saved.push(ping);
      localStorage.setItem('wari_offline_gps_queue', JSON.stringify(saved));
    } catch (e) {}
  }

  function syncBufferedPings() {
    try {
      const saved = JSON.parse(localStorage.getItem('wari_offline_gps_queue') || '[]');
      if (saved.length === 0) return;

      fetch('/tracker/api/sync-pings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pings: saved })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          localStorage.removeItem('wari_offline_gps_queue');
          console.log(`[PWA Offline Sync] Successfully synced ${data.syncedCount} buffered pings.`);
        }
      })
      .catch(() => {});
    } catch (e) {}
  }

