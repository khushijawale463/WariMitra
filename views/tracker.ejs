    fetchNearbyFacilities();
  }

  function selectFacilitySubCategory(subcat) {
    activeFacilitySubCat = subcat;
    document.querySelectorAll('.btn-fac-sub').forEach(btn => {
      if (btn.getAttribute('data-subcat') === subcat) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
    fetchNearbyFacilities();
