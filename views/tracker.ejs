<script>
  // State & Data
  const userLoc = { lat: 17.6750, lng: 75.3200, name: "Mauli Patil (You)", role: "Troop Leader" };
  const dindiLeaderLoc = { lat: 17.6820, lng: 75.3260, name: "Mauli Patil (Leader)" };

  const troopsData = [
    { id: 't1', name: 'Dindi #1 - Gyaneshwar Maharaj Palkhi', lat: 17.6820, lng: 75.3260, members: 1200, leader: 'HVB Chopdar' },
    { id: 't2', name: 'Dindi #12 - Tukaram Maharaj Palkhi', lat: 17.6710, lng: 75.3140, members: 950, leader: 'More Maharaj' },
    { id: 't3', name: 'Dindi #24 - Shri Sopan Kaka Palkhi', lat: 17.6755, lng: 75.3210, members: 450, leader: 'Mauli Patil' }
  ];

  const friendsData = [
    { id: 'f1', name: 'Rahul Patil', lat: 17.6770, lng: 75.3215, distance: '350m away', battery: '85%', updated: '2m ago' },
    { id: 'f2', name: 'Priya Joshi', lat: 17.6820, lng: 75.3280, distance: '1.2 km away', battery: '64%', updated: '5m ago' },
    { id: 'f3', name: 'Amit Shinde', lat: 17.6650, lng: 75.3100, distance: '2.8 km away', battery: '28%', updated: '12m ago' },
    { id: 'f4', name: 'Santosh Gaikwad', lat: 17.6600, lng: 75.3020, distance: '4.1 km away', battery: '45%', updated: '18m ago' }
  ];

  let mapInstance = null;
  let markersMap = {};
  let facilityMarkers = [];
  let heatmapLayer = null;
  let isHeatmapActive = false;

  let currentFilter = 'all';
  let activeFacilitySubCat = 'all';

  // Navigation State
  let isNavigating = false;
  let activePolyline = null;
  let activeTarget = null;
  let watchPositionId = null;
  let lastCalcLoc = null;

  // Phase 2 Settings State
  let isMarathiVoiceEnabled = true;
  let straySafeThresholdMeters = 300;
  let offlineGpsQueue = [];

  // Haversine Distance Helper (in meters)
  function haversineMeters(lat1, lon1, lat2, lon2) {
    const R = 6371000;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return Math.round(R * c);
  }

  function formatDistanceText(meters) {
    if (meters < 1000) return `${meters}m`;
    return `${(meters / 1000).toFixed(1)} km`;
  }

  /* -------------------------------------------------------------
     PHASE 2 FEATURE 8: MARATHI VOICE GUIDANCE (WEB SPEECH API)
     Phrasing flagged for native Marathi speaker review:
     - Left turn: "डावीकडे वळा" (Davikade vala)
     - Right turn: "उजवीकडे वळा" (Ujvikade vala)
     - Straight: "सरळ रस्ता धरा" (Saral rasta dhara)
     - Arrival: "तुम्ही गंतव्य स्थळावर पोहोचला आहात" (Tumhi gantavya sthalavar pohochla aahat)
     - Stray Alert: "सावधान! तुम्ही तुमच्या दिंडी गटापासून ३०० मीटरपेक्षा जास्त लांब गेला आहात."
     - SOS Confirmation: "आपला आणीबाणी संदेश वैद्यकीय पथकाकडे पाठवला आहे."
  ------------------------------------------------------------- */
  function speakMarathiPrompt(text) {
    if (!isMarathiVoiceEnabled || !('speechSynthesis' in window)) return;

    window.speechSynthesis.cancel(); // Stop any pending utterance
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'mr-IN';
    utterance.rate = 0.9; // Slightly slower for clear outdoor comprehension

    // Check if Marathi voice is installed on device, else fallback to default
    const voices = window.speechSynthesis.getVoices();
    const mrVoice = voices.find(v => v.lang.includes('mr') || v.lang.includes('hi'));
    if (mrVoice) utterance.voice = mrVoice;

    window.speechSynthesis.speak(utterance);
  }

  function toggleMarathiVoice(enabled) {
    isMarathiVoiceEnabled = enabled;
    if (enabled) {
      speakMarathiPrompt("मराठी आवाज मार्गदर्शन सुरु झाले आहे"); // Voice guidance activated
    }
  }

