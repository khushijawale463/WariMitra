    function setLanguage(lang) {
      localStorage.setItem('warimitra_lang', lang);
      
      const btnEn = document.getElementById('btn-lang-en');
      const btnMr = document.getElementById('btn-lang-mr');
      if (btnEn && btnMr) {
        if (lang === 'mr') {
          btnEn.classList.remove('active');
          btnMr.classList.add('active');
          document.body.classList.add('lang-mr');
        } else {
          btnMr.classList.remove('active');
          btnEn.classList.add('active');
          document.body.classList.remove('lang-mr');
        }
      }

      const dict = i18nTranslations[lang] || i18nTranslations.en;

      // Update text elements
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) {
          el.innerHTML = dict[key];
        }
      });

      // Update placeholder attributes
      document.querySelectorAll('[data-i18n-ph]').forEach(el => {
        const key = el.getAttribute('data-i18n-ph');
        if (dict[key]) {
          el.setAttribute('placeholder', dict[key]);
        }
      });
    }

    // On page load, auto-restore selected language from localStorage
    document.addEventListener('DOMContentLoaded', () => {
      const savedLang = localStorage.getItem('warimitra_lang') || 'en';
      setLanguage(savedLang);
    });
  </script>
